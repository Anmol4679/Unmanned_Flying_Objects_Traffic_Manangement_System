# Database connection string (defaults to local PostgreSQL or SQLite fallback)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/utm_drone_db

# JWT Secret Key for signing tokens (change in production)
JWT_SECRET=super-secret-key-change-me

# Rate limit for login endpoint (e.g. "5/minute", "30/minute")
LOGIN_RATE_LIMIT=5/minute

